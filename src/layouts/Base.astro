---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import Contact from '../components/Contact.astro';
import geistUrl from '../assets/fonts/Geist-Variable.woff2?url';
import newsreaderUrl from '../assets/fonts/Newsreader-opsz.woff2?url';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}
const {
  title = 'Sankalp Rajeev | AI & Machine Learning Engineer | Portfolio',
  description = "Sankalp Rajeev is an AI/ML Engineer and dual master's candidate at the University of Michigan-Dearborn building production ML, LLM reliability, computer vision, and ML systems. Graduating December 2026 and available January 2027.",
  path = '/',
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(path, 'https://sankalprajeev.dev').href;
const ogTitle = 'Sankalp Rajeev | AI & Machine Learning Engineer';
const ogDescription =
  'AI/ML Engineer building production ML, reliable LLM systems, computer vision, and ML infrastructure. Candidate for M.S. in Artificial Intelligence | M.S.E. in Robotics Engineering at the University of Michigan-Dearborn.';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sankalp Rajeev',
  jobTitle: 'Graduate Research Assistant',
  description: 'AI/ML engineer focused on reliable LLM systems, verifiers for LLM code repairs and production ML pipelines.',
  worksFor: { '@type': 'CollegeOrUniversity', name: 'University of Michigan-Dearborn' },
  url: 'https://sankalprajeev.dev/',
  sameAs: ['https://github.com/sankalp-rajeev', 'https://www.linkedin.com/in/sankalp-rajeev/', 'https://www.instagram.com/sankalp_rajeev/'],
  affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Michigan-Dearborn' },
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Arizona State University' }],
  email: 'mailto:srajeev@umich.edu',
  knowsAbout: ['Artificial Intelligence', 'Machine Learning', 'LLM Systems', 'AI Reliability', 'Computer Vision', 'ML Systems', 'MLOps', 'Edge AI', 'Python', 'PyTorch'],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#f4f1ea" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Sankalp Rajeev, AI Engineer, Machine Learning Engineer, ML Engineer, LLM Engineer, Computer Vision Engineer, Applied AI Engineer, AI Reliability, ML Systems, MLOps, PyTorch, TensorRT, Docker, Kubernetes, University of Michigan"
    />
    <meta name="author" content="Sankalp Rajeev" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={path === '/' ? ogTitle : title} />
    <meta property="og:description" content={path === '/' ? ogDescription : description} />
    <meta property="og:image" content="https://sankalprajeev.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sankalp Rajeev: I build AI systems that check their own work." />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={path === '/' ? ogTitle : title} />
    <meta property="twitter:description" content={path === '/' ? ogDescription : description} />
    <meta property="twitter:image" content="https://sankalprajeev.dev/og.png" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />

    <!-- Runs before first paint: theme, JS flag, and once-per-session entrance flag. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          d.dataset.theme = t === 'dark' ? 'dark' : 'light';
        } catch (e) {}
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', d.dataset.theme === 'dark' ? '#161513' : '#f4f1ea');
        var home = location.pathname === '/' || location.pathname === '/index.html';
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = false;
        try { seen = sessionStorage.getItem('entered') === '1'; } catch (e) {}
        if (home && !reduced && !seen) {
          d.classList.add('entrance');
          try { sessionStorage.setItem('entered', '1'); } catch (e) {}
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <svg width="0" height="0" aria-hidden="true" style="position:absolute"><filter id="mono" color-interpolation-filters="sRGB"><feColorMatrix type="saturate" values="0" /><feComponentTransfer><feFuncR type="discrete" tableValues="0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 1" /><feFuncG type="discrete" tableValues="0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 1" /><feFuncB type="discrete" tableValues="0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 1" /></feComponentTransfer></filter></svg>
    <Sidebar />
    <div class="content">
      <TopBar />
      <main id="main">
        <slot />
      </main>
      <Contact />
    </div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
