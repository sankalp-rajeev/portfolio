---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const featured = (await getCollection('projects')).filter((p) => p.data.featured !== undefined);
  return featured.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const p = project.data;
---

<Base title={`${p.title} | Sankalp Rajeev`} description={p.tagline} path={`/work/${project.id}`}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow"><a class="link" href="/#work">← Selected work</a></p>
      <h1 class="title">{p.title}</h1>
      <p class="tagline">{p.tagline}</p>
      {p.figure && (
        <p class="fig"><span class="mono">{p.figure.value}</span> {p.figure.label}</p>
      )}
      <p class="mono pending">Case study page: built in step 2.</p>
    </div>
  </section>
</Base>

<style>
  .title { margin: 24px 0 0; font-size: var(--fs-display); font-weight: 550; letter-spacing: -0.03em; line-height: 1.05; }
  .tagline { margin: 24px 0 0; max-width: 60ch; color: var(--text-2); }
  .fig { margin: 24px 0 0; color: var(--text-2); }
  .fig .mono { color: var(--text); font-size: var(--fs-figure); margin-right: 8px; }
  .pending { margin: 48px 0 0; font-size: var(--fs-mono); color: var(--text-3); }
</style>
