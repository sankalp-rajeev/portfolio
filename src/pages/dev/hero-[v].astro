---
// Dev-only: hero background prototypes. getStaticPaths is empty in production builds, so nothing is emitted.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? (['a', 'b', 'c'] as const).map((v) => ({ params: { v } })) : [];
}
const { v } = Astro.params;
---
<Base title={`dev hero-${v}`} path={`/dev/hero-${v}`}>
  <Hero bg={v as 'a' | 'b' | 'c'} />
</Base>
