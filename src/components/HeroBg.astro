---
interface Props {
  variant: 'a' | 'b' | 'c';
}
const { variant } = Astro.props;
---

<!-- Decorative art. Owned by the right side; masked so text contrast stays AA. Scripts mount into this node. -->
<div class="hero-bg" data-hero-bg={variant} aria-hidden="true"></div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    /* Functional fade (not decoration): keeps the left text column and the facts row clean. */
    -webkit-mask-image: linear-gradient(to right, transparent 34%, black 62%), linear-gradient(to bottom, black 48%, transparent 80%);
    mask-image: linear-gradient(to right, transparent 34%, black 62%), linear-gradient(to bottom, black 48%, transparent 80%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  /* Narrow screens: the text spans the full width, so the art sits in the band between the actions and the facts. */
  @media (max-width: 899px) {
    .hero-bg {
      opacity: 0.6;
      -webkit-mask-image: linear-gradient(to bottom, transparent 28%, black 40%, black 50%, transparent 64%);
      mask-image: linear-gradient(to bottom, transparent 28%, black 40%, black 50%, transparent 64%);
    }
  }
  .hero-bg :global(canvas),
  .hero-bg :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import { mountHeroBg } from '../scripts/hero-bg/mount';
  document.addEventListener('astro:page-load', mountHeroBg);
  document.addEventListener('astro:before-swap', () => (window as any).__heroBgDestroy?.());
</script>
