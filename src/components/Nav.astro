---
const items = [
  { id: 'work', label: 'Work', href: '/#work' },
  { id: 'experience', label: 'Experience', href: '/#experience' },
  { id: 'about', label: 'About', href: '/#about' },
];
const onWork = Astro.url.pathname.startsWith('/work');
---

<header class="nav nav-enter" data-nav>
  <div class="nav-bg" aria-hidden="true"></div>
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Sankalp Rajeev, home">Sankalp<span class="brand-last"> Rajeev</span></a>
    <div class="nav-right">
      <nav aria-label="Primary">
        <ul class="links" data-links>
          {items.map((i) => (
            <li>
              <a href={i.href} data-section={i.id} aria-current={onWork && i.id === 'work' ? 'page' : undefined}>{i.label}</a>
            </li>
          ))}
          <li>
            <a href="/Sankalp_Rajeev-Resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
          </li>
          <li class="indicator" data-indicator aria-hidden="true"></li>
        </ul>
      </nav>
      <slot />
    </div>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; height: var(--nav-h); }
  .nav-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: var(--nav-bg);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    transition: opacity var(--dur-hover) var(--ease);
  }
  .nav[data-scrolled='true'] .nav-bg { opacity: 1; }
  .nav-inner { position: relative; height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { font-weight: 550; font-size: var(--fs-label); letter-spacing: -0.01em; white-space: nowrap; }
  .nav-right { display: flex; align-items: center; gap: 4px; }
  .links { position: relative; display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .links a {
    display: block;
    padding: 8px 10px;
    font-size: var(--fs-ui);
    color: var(--text-2);
  }
  .links a:hover,
  .links a[aria-current] { color: var(--text); }
  .indicator {
    position: absolute;
    left: 0;
    bottom: 2px;
    height: 2px;
    width: 1px;
    transform-origin: 0 50%;
    background: var(--accent);
    opacity: 0;
    border-radius: 1px;
    pointer-events: none;
  }
  @media (max-width: 520px) {
    .brand-last { display: none; }
    .links a { padding-inline: 7px; font-size: var(--fs-mono); }
  }
  @media (max-width: 340px) {
    .links a { padding-inline: 4px; }
  }
  @media (max-width: 375px) {
    .nav-inner { gap: 8px; }
    .links { gap: 0; }
    .links a { padding-inline: 5px; font-size: 0.75rem; }
    .brand { font-size: var(--fs-ui); }
  }
</style>
