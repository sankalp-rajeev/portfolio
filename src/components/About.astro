---
import Ink from './Ink.astro';

const focus = ['LLM evaluation & verification', 'Agent reliability', 'Computer vision on the edge', 'ML systems'];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="col">
    <h2 id="about-title" class="h2" data-reveal>About</h2>
    <div class="prose" data-reveal>
      <p>
        I'm a dual master's student at the University of Michigan–Dearborn (M.S. Artificial Intelligence and M.S.E. Robotics
        Engineering, graduating December 2026) and currently a Graduate Research Assistant working on the reliability of LLM
        software repair.
      </p>
      <p>
        Before that I built production computer vision at Magna, LLM tools at Zoetis and edge inference at Mistral Solutions.
        I'm open to AI/ML and Forward Deployed Engineer roles from January 2027 in the SF Bay Area, NYC or Seattle.
      </p>
    </div>

    <div class="focus" data-reveal>
      <p class="label">Focus</p>
      <ul>
        {focus.map((f) => <li>{f}</li>)}
      </ul>
      <Ink
        class="ink-desk"
        vb="0 0 60 36"
        par="xMidYMid meet"
        d="M3 22 C 14 13, 27 27, 53 17 M53 17 L 44 10 M53 17 L 46 26"
        width={2.8}
        style="left:56px;top:-2px;width:46px;height:28px;"
      />
    </div>
  </div>
</section>

<style>
  .prose p { margin: 0 0 var(--s-2); font-size: var(--fs-body); line-height: 1.7; max-width: 38em; text-wrap: pretty; }
  .focus { position: relative; display: grid; grid-template-columns: 84px 1fr; column-gap: var(--s-6); margin-top: var(--s-4); align-items: start; }
  .label { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: var(--fs-title); line-height: 1.3; color: var(--text); }
  .focus ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: var(--fs-body); color: var(--text); }
  .focus li { line-height: 1.5; }
</style>
