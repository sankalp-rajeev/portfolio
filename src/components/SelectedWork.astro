---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <h2 id="work-title" class="eyebrow">Selected work</h2>
    <div class="grid">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
    <p class="all"><a class="link" href="/#all-projects">All projects <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--s-8) var(--s-4); margin-top: var(--s-5); }
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-10); } }
  .all { margin: var(--s-8) 0 0; font-size: var(--fs-base); }
</style>
