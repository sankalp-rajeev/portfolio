---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="col">
    <h2 id="work-title" class="h2" data-reveal>Selected work</h2>
    <div class="grid">
      {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
    <p class="all" data-reveal><a class="link" href="/#all-projects">All projects <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--s-8) var(--s-4); }
  /* The grid overhangs the 720px text column symmetrically; the heading keeps the column's left edge. */
  @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-10); align-items: stretch; } }
  .all { margin: var(--s-6) 0 0; font-size: var(--fs-base); }
  .all .link { display: inline-flex; align-items: center; min-height: 40px; }
</style>
