---
import data from '../data/contributions.json';
import { toCompact, buildSvg, label, type Compact } from '../lib/activity';

// Our own inline SVG contribution graph, rendered from the build-time snapshot (src/data/contributions.json).
// Only the latest year is in the HTML; the other years ship as compact data and are built on demand (keeps Home light).
const snap = (data as unknown) as { years?: Parameters<typeof toCompact>[0][]; generatedAt?: string };
const compact: Compact[] = (snap.years ?? []).map(toCompact);
const latest = compact[0];
const latestSvg = latest ? buildSvg(latest) : null;
const rest = compact.slice(1);
const ramp = [0, 1, 2, 3, 4];
---

{latest && latestSvg && (
  <section id="activity" class="section" aria-labelledby="activity-title">
    <div class="col">
      <h2 id="activity-title" class="h2" data-reveal>Activity</h2>
      <div class="act" data-reveal data-activity>
        <div class="main">
          <div class="scroller" data-act-scroll>
            <div class="stack">
              <div class="panel on" data-year={latest.year} data-last-x={latestSvg.lastX} set:html={latestSvg.html}></div>
            </div>
          </div>
          <div class="caps">
            <p class="cap on" data-year={latest.year}>{label(latest)}</p>
          </div>
          <div class="legend" aria-hidden="true">
            <span>Less</span>
            {ramp.map((l) => <i class={`sw l${l}`}></i>)}
            <span>More</span>
          </div>
        </div>
        <div class="years" role="group" aria-label="Choose a year" data-years hidden>
          {compact.map((p, i) => <button type="button" data-year={p.year} aria-pressed={i === 0 ? 'true' : 'false'}>{p.year}</button>)}
        </div>
        <div class="tip" data-act-tip role="presentation" hidden></div>
        <script type="application/json" data-act-data set:html={JSON.stringify(rest)}></script>
      </div>
      <p class="src mono" data-reveal>From the GitHub contribution calendar, snapshot taken {snap.generatedAt}.</p>
    </div>
  </section>
)}

<style>
  .act {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--s-3);
    padding: var(--s-2) var(--s-3) var(--s-2) var(--s-2);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  }
  .main { min-width: 0; }
  .scroller { overflow-x: auto; overscroll-behavior-x: contain; }
  .stack { display: grid; }
  .panel { grid-area: 1 / 1; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 200ms var(--ease), visibility 0s 200ms; }
  .panel.on { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity 200ms var(--ease), visibility 0s; }
  .panel :global(svg) { display: block; width: 100%; height: auto; max-width: 100%; font-family: var(--font-sans); }
  .panel :global(.mo) { font-size: 12.5px; fill: var(--text-3); }
  .panel :global(.c.l0) { fill: var(--g0); }
  .sw.l0 { background: var(--g0); }
  .panel :global(.c.l1) { fill: var(--g1); }
  .sw.l1 { background: var(--g1); }
  .panel :global(.c.l2) { fill: var(--g2); }
  .sw.l2 { background: var(--g2); }
  .panel :global(.c.l3) { fill: var(--g3); }
  .sw.l3 { background: var(--g3); }
  .panel :global(.c.l4) { fill: var(--g4); }
  .sw.l4 { background: var(--g4); }
  @media (hover: hover) and (pointer: fine) { .panel :global(.c:hover) { stroke: var(--text); stroke-width: 1px; } }
  .caps { display: grid; margin-top: 10px; }
  .cap { grid-area: 1 / 1; margin: 0; font-size: var(--fs-ui); color: var(--text-2); opacity: 0; visibility: hidden; transition: opacity 200ms var(--ease), visibility 0s 200ms; }
  .cap.on { opacity: 1; visibility: visible; transition: opacity 200ms var(--ease), visibility 0s; }
  .legend { display: flex; align-items: center; justify-content: flex-end; gap: 4px; margin-top: 8px; font-size: var(--fs-mono); color: var(--text-3); }
  .legend span { margin-inline: 4px; }
  .sw { display: inline-block; width: 11px; height: 11px; border-radius: 2px; }

  .years { display: flex; flex-direction: column; gap: 4px; align-self: start; }
  .years[hidden] { display: none; }
  .years button {
    height: 40px; min-width: 64px; padding: 0 12px; border-radius: 10px; border: 1px solid transparent; background: none;
    color: var(--text-2); font: inherit; font-family: var(--font-mono); font-size: var(--fs-mono); cursor: pointer; touch-action: manipulation;
    transition: transform var(--dur-press) var(--ease);
  }
  .years button:active { transform: scale(0.97); }
  .years button:hover { color: var(--text); }
  .years button[aria-pressed='true'] { background: var(--solid); color: var(--on-solid); }

  .tip {
    position: absolute; z-index: 5; pointer-events: none; white-space: nowrap;
    padding: 5px 9px; border-radius: 6px; font-size: var(--fs-mono); line-height: 1.3;
    background: var(--solid); color: var(--on-solid); transform: translate(-50%, -100%);
  }
  .tip[hidden] { display: none; }
  .src { margin: var(--s-2) 0 0; font-size: var(--fs-mono); color: var(--text-3); }

  /* Narrow screens: years sit below; the graph keeps its size and scrolls inside its container. */
  @media (max-width: 700px) {
    .act { grid-template-columns: minmax(0, 1fr); }
    .years { flex-direction: row; flex-wrap: wrap; }
    .panel :global(svg) { min-width: 739px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel, .panel.on, .cap, .cap.on { transition: opacity 150ms var(--ease), visibility 0s !important; }
  }
</style>
