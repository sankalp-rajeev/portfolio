---
const facts = [
  { label: 'Now', value: 'Graduate Research Assistant, University of Michigan–Dearborn' },
  { label: 'Studying', value: 'M.S. Artificial Intelligence and M.S.E. Robotics Engineering, graduating Dec 2026' },
  { label: 'Open to', value: 'AI/ML and Forward Deployed Engineer roles from January 2027, SF Bay Area, NYC or Seattle', live: true },
];
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="eyebrow hero-eyebrow">Sankalp Rajeev</p>

    <h1 id="hero-title" class="display">
      <span class="rise-line"><span>I build AI systems that</span></span>
      <span class="rise-line"><span>check their own work.</span></span>
    </h1>

    <p class="sub enter-sub">
      ML engineer focused on reliability: verifiers for LLM code repairs, self-healing agent platforms, and production ML
      pipelines.
    </p>

    <div class="actions enter-actions">
      <a class="btn btn-primary" href="/Sankalp_Rajeev-Resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
      <a class="btn" href="https://github.com/sankalp-rajeev" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="btn" href="https://www.linkedin.com/in/sankalp-rajeev/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="link small" href="https://www.instagram.com/sankalp_rajeev/" target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>

    <dl class="facts enter-facts">
      {facts.map((f) => (
        <div class="fact">
          <dt class="mono">
            {f.live && <span class="dot" aria-hidden="true"></span>}
            {f.label}
          </dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero { padding-top: clamp(48px, 9vh, 112px); padding-bottom: var(--s-10); }
  @media (min-width: 768px) { .hero { padding-bottom: var(--s-12); } }
  .hero-eyebrow { margin-bottom: var(--s-4); }
  .display {
    margin: 0;
    font-size: var(--fs-display);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1;
    max-width: 14em;
  }
  /* Clipped mask: each line rises out of its own box. Padding keeps descenders unclipped. */
  .rise-line { display: block; overflow: hidden; padding-bottom: 0.14em; margin-bottom: -0.14em; }
  .rise-line > span { display: block; text-wrap: balance; }
  .sub {
    margin: var(--s-4) 0 0;
    max-width: 38em;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: var(--s-5); }
  .small { font-size: var(--fs-label); padding: 12px 4px; color: var(--text-2); }
  .facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
    margin: var(--s-10) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-4); margin-top: var(--s-12); }
  }
  .fact dt { display: flex; align-items: center; gap: 8px; font-size: var(--fs-mono); color: var(--text-3); margin-bottom: 8px; }
  .fact dd { margin: 0; font-size: var(--fs-base); line-height: 1.5; color: var(--text); max-width: 32em; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
</style>
