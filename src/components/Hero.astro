---
import HeroBg from './HeroBg.astro';

interface Props {
  bg?: 'a' | 'b' | 'c';
}
const { bg } = Astro.props;

const facts = [
  { label: 'Now', value: 'Graduate Research Assistant, University of Michigan–Dearborn' },
  { label: 'Studying', value: 'M.S. Artificial Intelligence and M.S.E. Robotics Engineering, graduating Dec 2026' },
  { label: 'Open to', value: 'AI/ML and Forward Deployed Engineer roles from January 2027, SF Bay Area, NYC or Seattle', live: true },
];
---

<section id="home" class="hero" aria-labelledby="hero-title">
  {bg && <HeroBg variant={bg} />}
  <div class="wrap hero-inner">
    <div class="copy">
      <h1 id="hero-title" class="display">
        <span class="rise-line"><span>I build AI systems that</span></span>
        <span class="rise-line"><span>check their own work.</span></span>
      </h1>

      <p class="sub enter-sub">
        ML engineer focused on reliability: verifiers for LLM code repairs, self-healing agent platforms, and production ML
        pipelines.
      </p>

      <div class="actions enter-actions">
        <a class="btn btn-primary" href="/Sankalp_Rajeev-Resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
        <a class="link ext" href="https://github.com/sankalp-rajeev" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a class="link ext" href="https://www.linkedin.com/in/sankalp-rajeev/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="link small" href="https://www.instagram.com/sankalp_rajeev/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div>

    <dl class="facts enter-facts">
      {facts.map((f) => (
        <div class="fact">
          <dt class="mono">
            {f.live && <span class="dot" aria-hidden="true"></span>}
            {f.label}
          </dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(880px, calc(100svh - var(--nav-h)));
    display: flex;
    padding-top: clamp(40px, 8vh, 96px);
    padding-bottom: var(--s-10);
  }
  @media (min-width: 768px) { .hero { padding-bottom: var(--s-12); } }
  .hero-inner { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-12); }
  @media (min-width: 900px) { .copy { max-width: calc(50% - 12px); } }

  .display {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }
  .rise-line { display: block; }
  .rise-line > span { display: block; text-wrap: balance; }
  .sub {
    margin: var(--s-4) 0 0;
    max-width: 34em;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px var(--s-4); margin-top: var(--s-5); }
  .ext { font-size: var(--fs-label); font-weight: 500; text-decoration-color: transparent; }
  .ext:hover { text-decoration-color: currentColor; }
  .ext span { color: var(--text-3); }
  .small { font-size: var(--fs-ui); color: var(--text-2); }

  .facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
    margin: 0;
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-8); }
  }
  .fact dt { display: flex; align-items: center; gap: 8px; font-size: var(--fs-mono); color: var(--text-3); margin-bottom: 12px; }
  .fact dd { margin: 0; font-size: var(--fs-base); line-height: 1.55; color: var(--text); max-width: 30em; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
</style>
