---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

const facts = [
  { icon: 'pin', text: 'Dearborn, MI' },
  { icon: 'compass', text: 'Open to SF Bay Area, NYC, Seattle' },
  { icon: 'calendar', text: 'Available January 2027' },
];
const social = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/sankalp-rajeev/', icon: 'linkedin' },
  { label: 'GitHub', href: 'https://github.com/sankalp-rajeev', icon: 'github' },
  { label: 'Instagram', href: 'https://www.instagram.com/sankalp_rajeev/', icon: 'instagram' },
];
const paths: Record<string, string> = {
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  calendar: '<path d="M8 2v4M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  instagram: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};
---

<aside class="sidebar" aria-label="Profile">
  <div class="top">
    <Image class="portrait" src={portrait} alt="Portrait of Sankalp Rajeev" width={96} height={96} densities={[1, 2]} format="webp" quality={85} loading="eager" />
    <div class="id">
      <p class="name">Sankalp Rajeev</p>
      <p class="role">AI / ML Engineer</p>
    </div>
  </div>

  <p class="line">Graduate Research Assistant, UM–Dearborn</p>

  <ul class="facts">
    {facts.map((f) => (
      <li>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[f.icon]} />
        <span>{f.text}</span>
      </li>
    ))}
  </ul>

  <div class="bottom">
    <ul class="social">
      {social.map((s) => (
        <li>
          <a class="icon-btn" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[s.icon]} />
          </a>
        </li>
      ))}
    </ul>
    <div class="cta">
      <a class="btn btn-primary dl" href="/Sankalp_Rajeev-Resume.pdf" download>Download CV</a>
      <a class="btn mail" href="mailto:srajeev@umich.edu" aria-label="Email Sankalp">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths.mail} />
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-3) var(--gutter) var(--s-4); border-bottom: 1px solid var(--line); }
  .top { display: flex; align-items: center; gap: var(--s-2); }
  .portrait { width: 96px; height: 96px; border-radius: var(--radius-sm); object-fit: cover; filter: grayscale(1); flex: none; background: var(--surface-2); }
  .name { margin: 0; font-family: var(--font-serif); font-optical-sizing: auto; font-size: 1.75rem; font-weight: 500; line-height: 1.1; letter-spacing: -0.01em; }
  .role { margin: 4px 0 0; font-size: var(--fs-label); color: var(--text-2); }
  .line { margin: 0; font-size: var(--fs-label); line-height: 1.5; color: var(--text); max-width: 26em; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: var(--fs-ui); color: var(--text-2); }
  .facts li { display: flex; align-items: center; gap: 10px; }
  .facts svg { flex: none; color: var(--text-3); }
  .bottom { display: grid; gap: var(--s-2); margin-top: auto; }
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; }
  .icon-btn {
    display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 10px;
    border: 1px solid var(--line); color: var(--text-2);
    transition: transform var(--dur-press) var(--ease);
  }
  .icon-btn:hover { color: var(--accent); border-color: var(--line-strong); }
  .icon-btn:active { transform: scale(0.95); }
  .cta { display: flex; gap: 8px; }
  .dl { flex: 1; }
  .mail { width: 44px; padding: 0; flex: none; }

  /* ≥1024px: fixed left rail with a hairline right border. */
  @media (min-width: 1024px) {
    .sidebar {
      position: fixed; inset: 0 auto 0 0; width: var(--sidebar-w); z-index: 20;
      border-bottom: 0; border-right: 1px solid var(--line);
      padding: var(--s-5) var(--s-3) var(--s-4); overflow-y: auto; background: var(--bg);
    }
    .top { flex-direction: column; align-items: flex-start; }
  }
  /* <1024px: profile block above the content; buttons sit in a row. */
  @media (max-width: 1023px) {
    .bottom { margin-top: 0; grid-template-columns: auto 1fr; align-items: center; gap: var(--s-2); }
    .cta { justify-content: flex-end; }
    .dl { flex: 0 1 auto; }
  }
  @media (max-width: 520px) {
    .bottom { grid-template-columns: 1fr; }
    .cta { justify-content: stretch; }
    .dl { flex: 1; }
  }
</style>
