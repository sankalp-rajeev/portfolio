---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Ink from './Ink.astro';
import { duration } from '../lib/duration';

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.png', { eager: true });
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="col">
    <h2 id="experience-title" class="h2" data-reveal>Experience</h2>
    <ol class="timeline">
      {roles.map((r, i) => {
        const d = r.data;
        const logo = logos[`/src/assets/logos/${d.logo}.png`]?.default;
        return (
          <li class="entry" data-reveal data-entry>
            <div class="rail">
              <div class="logo">{logo && <Image src={logo} alt="" width={36} height={36} densities={[2, 3]} format="webp" loading="lazy" />}</div>
              {i < roles.length - 1 && <span class="seg" data-seg aria-hidden="true"></span>}
            </div>
            <div class="body">
              <div class="head">
                <div class="who">
                  <h3 class="role">{d.role}{d.detail && <span class="detail">, {d.detail}</span>}</h3>
                  <p class="co">{d.company} · {d.kind}</p>
                </div>
                <p class="when mono">
                  <span>{d.dates}</span>
                  <span class="dur">{duration(d.start, d.end)}</span>
                </p>
              </div>
              <ul class="bullets">
                {d.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <ul class="tags" aria-label="Technologies">
                {d.tags.map((t) => <li class="mono">{t}</li>)}
              </ul>
              {d.verified && (
                <Ink
                  class="ink-desk ink-margin"
                  vb="0 0 34 26"
                  par="xMidYMid meet"
                  d="M3 14 C 7 16, 9 20, 12 23 C 15 15, 21 8, 31 3"
                  width={2.8}
                  style="left:calc(100% + 18px);top:6px;width:26px;height:20px;"
                  note="verified"
                  noteStyle="left:32px;top:-1px;--r:-4deg;"
                />
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; }
  .entry { display: grid; grid-template-columns: 44px 1fr; column-gap: var(--s-3); padding-bottom: var(--s-6); }
  .entry:last-child { padding-bottom: 0; }
  .rail { position: relative; display: flex; flex-direction: column; align-items: center; }
  .logo {
    width: 44px; height: 44px; flex: none; display: grid; place-items: center; overflow: hidden;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm);
  }
  .logo :global(img) { width: 36px; height: 36px; object-fit: contain; filter: url(#mono); /* single-colour: every non-white pixel becomes ink */ }
  /* The vertical hairline connecting roles. */
  .seg { position: absolute; top: 52px; bottom: calc(var(--s-6) * -1 + 8px); width: 1px; background: var(--line-strong); }
  .body { position: relative; min-width: 0; }
  .head { display: flex; justify-content: space-between; gap: var(--s-3); align-items: flex-start; }
  .who { min-width: 0; }
  .role { margin: 0; font-family: var(--font-serif); font-optical-sizing: auto; font-size: var(--fs-title); font-weight: 500; line-height: 1.25; letter-spacing: -0.005em; text-wrap: balance; }
  .detail { color: var(--text-2); font-weight: 400; }
  .co { margin: 4px 0 0; font-size: var(--fs-ui); color: var(--text-2); }
  .when { margin: 3px 0 0; display: grid; justify-items: end; gap: 2px; flex: none; font-size: var(--fs-mono); color: var(--text-2); text-align: right; white-space: nowrap; }
  .dur { color: var(--text-3); }
  .bullets { max-width: 68ch; margin: var(--s-2) 0 0; padding: 0 0 0 1.1em; display: grid; gap: 10px; font-size: var(--fs-label); line-height: 1.6; color: var(--text); }
  .bullets li::marker { color: var(--text-3); }
  .tags { list-style: none; margin: var(--s-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { padding: 2px 8px; font-size: var(--fs-eyebrow); color: var(--text-2); border: 1px solid var(--line-strong); border-radius: 6px; }

  @media (max-width: 560px) {
    .entry { grid-template-columns: 36px 1fr; column-gap: var(--s-2); }
    .logo { width: 36px; height: 36px; }
    .logo :global(img) { width: 28px; height: 28px; }
    .seg { top: 44px; }
    .head { flex-direction: column; gap: 6px; }
    .when { justify-items: start; text-align: left; grid-auto-flow: column; column-gap: 12px; margin: 0; }
  }
</style>
