---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const p = project.data;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{png,jpg,webp}', { eager: true });
const key = p.image ? `/src/assets/projects/${p.image.split('/').pop()}` : '';
const shot = images[key]?.default;
const href = `/work/${project.id}`;
---

<article class="card" data-reveal data-index={index}>
  <div class="frame">
    <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="shot">
      {shot ? (
        <Image
          src={shot}
          alt={`${p.title} interface`}
          widths={[560, 840, 1120]}
          sizes="(min-width: 1280px) 560px, (min-width: 768px) 45vw, 92vw"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="missing"><span class="mono">No screenshot yet</span></div>
      )}
    </div>
    <span class="edge" aria-hidden="true"></span>
  </div>

  <div class="body">
    <h3 class="title">
      <a href={href}>{p.title}</a>
      <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </h3>
    {p.tagline && <p class="desc">{p.tagline}</p>}

    {p.figure && (
      <p class="figure">
        <span class="mono value">{p.figure.value}</span>
        <span class="label">{p.figure.label}</span>
      </p>
    )}

    {p.stack && <p class="stack mono">{p.stack.join(' · ')}</p>}

    <ul class="links">
      {p.demoLink && <li><a class="link" href={p.demoLink} target="_blank" rel="noopener noreferrer">Live demo<span class="sr-only"> for {p.title}</span> ↗</a></li>}
      {p.github && <li><a class="link" href={p.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> for {p.title}</span> ↗</a></li>}
      {p.pypi && <li><a class="link mono" href={`https://pypi.org/project/${p.pypi}/`} target="_blank" rel="noopener noreferrer">pip install {p.pypi}</a></li>}
    </ul>
  </div>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; gap: var(--s-3); min-width: 0; }

  .frame {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-frame);
  }
  .bar {
    display: flex; align-items: center; gap: 6px; height: 28px; padding-inline: 12px;
    border-bottom: 1px solid var(--line); background: var(--surface-2);
  }
  .bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
  .shot { aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); }
  .shot :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block;
    transform: scale(1); transition: transform var(--dur-image) var(--ease);
  }
  .missing { height: 100%; display: grid; place-items: center; font-size: var(--fs-mono); color: var(--text-3); }
  /* Border lightening done with an overlay's opacity (transform/opacity only). */
  .edge {
    position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: inset 0 0 0 1px var(--line-strong); opacity: 0;
    transition: opacity var(--dur-hover) var(--ease);
  }

  .body { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .title { margin: 0; display: flex; align-items: center; gap: 8px; font-size: var(--fs-title); font-weight: 550; letter-spacing: -0.02em; line-height: 1.2; }
  .title a { overflow-wrap: anywhere; min-width: 0; }
  .title a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) .frame { outline: 2px solid var(--accent); outline-offset: 4px; }
  .arrow { flex: none; color: var(--text-3); transition: transform var(--dur-hover) var(--ease); }
  .desc { margin: 0; color: var(--text-2); font-size: var(--fs-base); line-height: 1.55; max-width: 60ch; text-wrap: pretty; }

  .figure {
    margin: 4px 0 0; padding-top: 16px; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 12px; row-gap: 2px;
  }
  .value { font-size: var(--fs-figure); font-weight: 500; color: var(--text); letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .label { font-size: var(--fs-label); color: var(--text-2); }
  .stack { margin: 0; font-size: var(--fs-mono); line-height: 1.6; color: var(--text-3); overflow-wrap: anywhere; }

  .links { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 4px 20px; list-style: none; margin: 4px 0 0; padding: 0; font-size: var(--fs-label); }
  .links .link { display: inline-block; padding-block: 4px; }
  .links .mono { font-size: var(--fs-mono); }

  /* Press feedback on the whole card (subtle: it is navigation, used often). */
  .frame { transition: transform var(--dur-press) var(--ease); }
  .card:active .frame { transform: scale(0.99); }
  @media (hover: hover) {
    .card:hover .shot :global(img) { transform: scale(1.03); }
    .card:hover .edge { opacity: 1; }
    .card:hover .arrow { transform: translateX(4px); color: var(--text); }
  }
  .card:has(.title a:focus-visible) .arrow { transform: translateX(4px); color: var(--text); }
</style>
